node_modules/
dist/
build/
*.log
.DS_Store
*.local
.env
.turbo/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Coverage output (packages/core via vitest, packages/web via the Playwright reporter)
coverage/
packages/core/coverage/

# Downloaded sources (frequency, HanDeDict, and the OpenSubtitles text for the bigram
# table), re-fetchable with build:dict and build:bigrams. Pinned by URL and
# SHA-256 in packages/core/scripts/sources.ts, so a copy here is always checked. CC-CEDICT
# and the HSK levels are not here: they are committed under packages/core/data/.
packages/core/.cache/

# The generated dictionary asset, the paged B+ tree that Rime, Android and the web app
# (through its gzip copy below) are built from. It is produced
# by `npm run build:dict` from the pinned CC-CEDICT, OpenSubtitles frequency list and
# HSK 3.0 levels, so it does not belong in version control: it is 9MB of derived
# data that the same commit always rebuilds byte for byte, and a commit that carries it
# is a 9MB diff nobody reads.
#
# A fresh clone therefore needs `npm run build:dict` before `npm run dev` or
# `npm run test:e2e` will show candidates. `npm run test:e2e` says so in those words
# rather than timing out on a missing asset.
packages/web/public/dictionary.btree

# The Candidate detail file built alongside it with the same build id (ADR 0002), and read
# by the detail parity generator. Its gzip copy is under packages/web/src/generated/ below.
packages/web/public/detail.bin

# The bigram table for Sentence candidates, from `npm run build:bigrams`, which counts it from
# the 173MB OpenSubtitles download (cached in packages/core/.cache/). Optional at runtime; the
# Android build copies it when present. Its gzip copy is under packages/web/src/generated/.
packages/web/public/bigrams.bin

# Android build state (packages/android)
packages/android/.gradle/
packages/android/build/
packages/android/app/build/
packages/android/local.properties
packages/android/.kotlin/
*.hprof

# Jacoco coverage output for the Android app (regenerate with ./gradlew jacocoTestReport)
packages/android/app/reports/
packages/android/app/.cxx/

# Everything in the platform rime/ folders is generated by `npm run build:rime`: the
# schemas, default.custom.yaml and the Lua filter are rendered from packages/rime/templates,
# and the two ~7MB dictionaries and the ~15MB Lua gloss sidecar are emitted from the
# dictionary asset. Edit the templates, not these.
packages/windows/rime/
packages/macos/rime/

# What `npm run setup:rime` provisions: a 172MB librime clone at the pinned tag 1.13.1,
# and a local prefix holding cmake, Boost headers and the compiled liblibrime.so plus the
# rime_smoke harness. Both are rebuilt from scratch by that script, which needs no sudo.
# bootstrap-rime.sh and rime_smoke.cc next to them *are* committed — they are the source.
packages/rime/tools/librime/
packages/rime/tools/.local/

# Where `setup:rime` and `build:rime` wrote before the shared files moved to packages/rime.
# Nothing writes here any more, but a checkout that ran them earlier still has a 172MB
# librime clone and its build on disk, and without these lines `git add -A` would commit it.
# Safe to delete those folders, and then these lines.
packages/windows/tools/librime/
packages/windows/tools/.local/
packages/macos/tools/librime/
packages/macos/tools/rime_smoke

# Android release signing. key.properties holds the keystore passwords; the trailing * also
# catches editor backups such as key.properties~. Keep the keystore itself outside the repo
# and point storeFile at its absolute path; these patterns are a backstop, not a home.
key.properties*
*.jks
*.keystore

# IDE state
.idea/

# The gzipped copy of the asset that the web app imports, so Vite gives it a
# content-hashed URL. Written by `npm run build:dict` with the asset above.
packages/web/src/generated/
