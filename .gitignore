node_modules/
dist/
build/
*.log
.DS_Store
*.local
.env
.turbo/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Coverage output (packages/core via vitest, packages/web via the Playwright reporter)
coverage/
packages/core/coverage/

# Downloaded frequency and HSK sources, re-fetchable with build:dict. Pinned by URL and
# SHA-256 in packages/core/scripts/sources.ts, so a copy here is always checked. CC-CEDICT
# is not here: it is committed under packages/core/data/.
packages/core/.cache/

# The generated dictionary assets. Both are produced by `npm run build:dict` from the
# pinned CC-CEDICT, OpenSubtitles frequency list and HSK 2012 word list, so neither belongs
# in version control: they are 9MB of derived data that the same commit always rebuilds
# byte for byte, and a commit that carries one is a 9MB diff nobody reads.
#
#   packages/web/public/dictionary.btree   the paged B+ tree the web app fetches
#   packages/web/public/dictionary.json    the legacy whole-corpus form, nothing reads it
#
# A fresh clone therefore needs `npm run build:dict` before `npm run dev` or
# `npm run test:e2e` will show candidates. `npm run test:e2e` says so in those words
# rather than timing out on a missing asset.
packages/web/public/dictionary.btree
packages/web/public/dictionary.json

# Android build state (packages/android)
packages/android/.gradle/
packages/android/build/
packages/android/app/build/
packages/android/local.properties
packages/android/.kotlin/
*.hprof

# Jacoco coverage output for the Android app (regenerate with ./gradlew jacocoTestReport)
packages/android/app/reports/
packages/android/app/.cxx/

# The generated Rime dictionaries. The hand-written schemas next to them are committed;
# these two are ~7MB each and are rebuilt by `npm run build:rime`.
packages/windows/rime/*.dict.yaml

# The generated Lua gloss sidecar the schema's filter reads. ~15MB, rebuilt by the same
# build. The hand-written filter itself (rime/lua/pinyinduck_gloss_filter.lua) is
# committed next to it.
packages/windows/rime/lua/pinyinduck_gloss.lua

# What `npm run setup:rime` provisions: a 172MB librime clone at the pinned tag 1.13.1,
# and a local prefix holding cmake, Boost headers and the compiled liblibrime.so plus the
# rime_smoke harness. Both are rebuilt from scratch by that script, which needs no sudo.
# bootstrap-rime.sh and rime_smoke.cc next to them *are* committed — they are the source.
packages/windows/tools/librime/
packages/windows/tools/.local/

# The same three artifacts for macOS (packages/macos), which runs the same emitter against
# the same asset. `npm run build:rime` writes both dictionaries and the Lua sidecar from one
# pass over the B+ tree; `npm run setup:rime` builds librime and the harness into tools/.
packages/macos/rime/*.dict.yaml
packages/macos/rime/lua/pinyinduck_gloss.lua

# What `npm run setup:rime` provisions for macOS: the librime clone and the compiled
# rime_smoke harness. bootstrap-rime.sh and rime_smoke.cc next to them *are* committed.
packages/macos/tools/librime/
packages/macos/tools/rime_smoke

# Android release signing. key.properties holds the keystore passwords; the trailing * also
# catches editor backups such as key.properties~. Keep the keystore itself outside the repo
# and point storeFile at its absolute path; these patterns are a backstop, not a home.
key.properties*
*.jks
*.keystore

# IDE state
.idea/
