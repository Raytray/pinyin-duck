{
  "name": "pinyin-typeduck",
  "version": "0.1.0",
  "private": true,
  "description": "TypeDuck-inspired Pinyin input method with real-time English definitions for Mandarin learners",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run -w @pinyinduck/web dev",
    "build:dict": "npm run build:dict -w @pinyinduck/core",
    "build": "npm run build:dict && npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "test:coverage": "npm run test:coverage -w @pinyinduck/core",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:e2e",
    "test:coverage:all": "npm run test:coverage && npm run test:e2e",
    "typecheck": "npm run --workspaces --if-present typecheck"
  },
  "keywords": [
    "pinyin",
    "mandarin",
    "chinese-input",
    "typeduck",
    "language-learning",
    "ime"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "v8-to-istanbul": "^9.3.0"
  }
}
