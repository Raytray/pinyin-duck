<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme for the settings activity. -->
    <style name="Theme.PinyinDuck" parent="@android:style/Theme.Material.Light.NoActionBar" />

    <!--
      The IME service window. It is full height, so the Candidate detail bubble can float over
      the app in the same window, and the part above the keyboard has to show the app through
      it: the background is transparent, and the keyboard paints its own (see #10 and
      docs/research/android-ime-bubble.md on the research/android-ime-bubble branch).
    -->
    <style name="Theme.PinyinDuck.Ime" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
