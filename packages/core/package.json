{
  "name": "@pinyinduck/core",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Core Pinyin parsing, CC-CEDICT lookup, and candidate ranking engine for PinyinDuck",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage",
    "build:dict": "tsx scripts/build-dictionary.ts",
    "build:parity": "tsx scripts/generate-android-parity.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
  }
}
