{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // TypeScript 7 no longer loads every installed @types package, so say which ones
    // this package uses. Node types came in only through vitest -> vite before.
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*"]
}
