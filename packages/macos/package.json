{
  "name": "@pinyinduck/macos",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Rime/Squirrel schema generator for the PinyinDuck macOS input method",
  "scripts": {
    "build": "tsc",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "build:rime": "tsx scripts/build-rime-dict.ts",
    "setup:rime": "bash tools/bootstrap-rime.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rime": "tsx scripts/verify-rime.ts",
    "test:rime:strict": "tsx scripts/verify-rime.ts --require"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
