{
  "name": "@pinyinduck/rime",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "Shared Rime schema templates, dictionary emitter and librime checks for the PinyinDuck Windows (Weasel) and macOS (Squirrel) input methods",
  "scripts": {
    "build": "tsc",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "build:rime": "tsx scripts/build-rime-dict.ts",
    "setup:rime": "bash tools/bootstrap-rime.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rime": "tsx scripts/verify-rime.ts",
    "test:rime:strict": "tsx scripts/verify-rime.ts --require",
    "ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:rime"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@pinyinduck/core": "*",
    "yaml": "^2.9.1"
  }
}
